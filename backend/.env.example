PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/fashion_db

JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# 5 Gemini API Keys
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=

GEMINI_MODEL=gemini-2.5-flash
GEMINI_THINKING_BUDGET=0
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSION=768

GEMINI_MAX_ATTEMPTS=5
GEMINI_MAX_IN_FLIGHT_PER_KEY=2
GEMINI_REQUEST_TIMEOUT_MS=30000
GEMINI_KEY_COOLDOWN_MS=30000
GEMINI_INVALID_KEY_COOLDOWN_MS=600000
GEMINI_MAX_KEY_WAIT_MS=1000

ATLAS_GEMINI_VECTOR_INDEX_NAME=gemini_vector_index

CHAT_MAX_MESSAGE_CHARS=2000
CHAT_HISTORY_LIMIT=12
CHAT_RAG_TOP_K=6
CHAT_ORDER_CONTEXT_LIMIT=3

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# VNPAY
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_QUERY_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
VNPAY_QUERY_IP=127.0.0.1
VNPAY_RETURN_URL=http://localhost:3000/api/payments/vnpay/return
